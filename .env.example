# ===== selfsend 服务 =====

# 监听地址 / 端口 / 日志级别 (DEBUG/INFO/WARNING/ERROR)
# 裸机部署保持默认；Docker Compose 会自动覆盖为 0.0.0.0
SELFSEND_HOST=127.0.0.1
SELFSEND_PORT=8787
SELFSEND_LOG_LEVEL=INFO

# 合法 API Key，逗号分隔。用 scripts/generate_key.py 生成，形如 re_xxxxxxxx
# 这是 melody-auth 中 RESEND_API_KEY 需要填的值
SELFSEND_API_KEYS=re_REPLACE_ME

# 强制覆盖所有邮件的发件人地址（仍保留请求中的显示名）。留空表示不覆盖
SELFSEND_FORCE_FROM=

# 允许的发件人域名白名单，逗号分隔。留空表示不限制
# 强烈建议设置为你自己的域名，防止 API Key 泄露后被人冒充其他域名发信
SELFSEND_ALLOWED_FROM_DOMAINS=

# 每个 API Key 每分钟最多请求次数，0 表示不限制
SELFSEND_RATE_LIMIT_PER_MINUTE=60

# 单次请求最大收件人数（to + cc + bcc）
SELFSEND_MAX_RECIPIENTS=50

# 请求体大小上限（字节）
SELFSEND_MAX_BODY_BYTES=2097152

# ===== 上游 SMTP =====

# 例如服务器本地 postfix: localhost:25；或第三方: smtp.example.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 端口 STARTTLS 一般为 true；25 端口无加密时可设为 false
SMTP_STARTTLS=true
# 465 端口隐式 SSL 设为 true（此时忽略 SMTP_STARTTLS）
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30
